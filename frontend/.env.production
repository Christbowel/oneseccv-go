# Production build config (read by `vite build`).
#
# The Google OAuth Client ID is PUBLIC by design — it ships inside every
# frontend bundle and is protected by the "Authorized JavaScript origins"
# allow-list in Google Cloud, not by secrecy. Safe to commit.
#
# A value set in the Vercel dashboard (same name) overrides this file.

VITE_GOOGLE_CLIENT_ID=551536629685-eftfskpg9njr70b0n1a8md4iu8hg54vt.apps.googleusercontent.com
VITE_OWNER_EMAIL=christbowel10@gmail.com

# Analytics (this is what counts your users). Public by design — the ID ships
# in the bundle and only accepts hits from the configured stream.
VITE_GA_MEASUREMENT_ID=G-RCT6DELW16

# Empty ⇒ the app calls same-origin /api/*, which vercel.json proxies to the
# compilation VPS. Leave empty in production.
VITE_COMPILER_URL=
