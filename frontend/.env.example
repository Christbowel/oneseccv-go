# ── OneSecCV web app ────────────────────────────────────────
# Copy to `.env.local` for local dev, and set the same variables in the
# Vercel project settings for production.

# Compilation server. Leave EMPTY in production: the app then calls
# same-origin `/api/...`, which vercel.json proxies to the VPS over HTTPS.
# Set it only for local dev against a remote compiler.
VITE_COMPILER_URL=

# ── Google Sign-In + Drive storage (required) ───────────────
# Google Cloud Console ▸ APIs & Services ▸ Credentials ▸
#   Create credentials ▸ OAuth client ID ▸ Web application
#
#   Authorised JavaScript origins:  https://<your-domain>       (and http://localhost:3000)
#   Enable the "Google Drive API" for the project.
#   OAuth consent screen scopes:    openid, email, profile,
#                                   .../auth/drive.appdata
VITE_GOOGLE_CLIENT_ID=

# ── Analytics: how you count your users (optional but recommended) ──
# Google Analytics 4 ▸ Admin ▸ Data streams ▸ Web ▸ Measurement ID (G-XXXXXXX).
# Signed-in visitors are tagged with their Google `sub` as GA4 `user_id`, so
# "Total users" is deduplicated across phone, laptop and installed PWA.
VITE_GA_MEASUREMENT_ID=

# Your own Google address. When you sign in with it, the account menu shows a
# shortcut to the GA4 dashboard. Cosmetic only — no privileged data exists.
VITE_OWNER_EMAIL=
